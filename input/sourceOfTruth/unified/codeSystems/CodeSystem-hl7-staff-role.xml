  <version value="1.0.0"/>
  <name value="HL7_Staff_Role"/>
  <title value="HL7 International Staff Roles"/>
  <status value="active"/>
  <experimental value="false"/>
  <date value="2026-08-13"/>
  <publisher value="Health Level Seven International"/>
  <contact>
    <telecom>
      <system value="url"/>
      <value value="http://hl7.org/"/>
    </telecom>
    <telecom>
      <system value="email"/>
      <value value="hq@HL7.org"/>
