    <property>
      <code value="type"/>
      <valueString value="Executive"/>
    </property>
    <property>
      <code value="roleStatus"/>
      <valueString value="active"/>
    </property>
    <property>
      <code value="jiraSpecItem"/>
      <valueBoolean value="false"/>
    </property>
  </concept>
